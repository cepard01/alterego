{
  "name": "alterego",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous conversational agent with long-term memory, identity, and simulated human behavior.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/runtime/main.ts",
    "dev:memory": "cross-env ALTEREGO_MEMORY_MODE=1 tsx src/runtime/main.ts"
  },
  "dependencies": {
    "ioredis": "^5.4.0",
    "pg": "^8.12.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true
  }
}
